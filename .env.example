# Vietnamese Street Food Discovery Platform - Environment Variables
# Copy this file to .env and fill in the values

# ===== Site Configuration =====
# Base URL for the site (used for canonical URLs and sitemap)
SITE_URL=https://qpssoft.github.io/Street-Food

# Public base path for GitHub Pages deployment
PUBLIC_BASE_PATH=/Street-Food

# ===== Analytics (Optional) =====
# Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
PUBLIC_GOOGLE_ANALYTICS_ID=

# ===== Build Configuration =====
# Node environment (development, production)
NODE_ENV=development

# ===== Performance & Optimization =====
# Enable image optimization during build (true/false)
ENABLE_IMAGE_OPTIMIZATION=true

# Maximum image width for optimization (pixels)
MAX_IMAGE_WIDTH=1920

# ===== Feature Flags (Optional) =====
# Enable Service Worker for offline access (Phase 9)
ENABLE_SERVICE_WORKER=false

# Enable color extraction from food images (Phase 10)
ENABLE_COLOR_EXTRACTION=false

# ===== Content Configuration =====
# Default language for the site
DEFAULT_LANG=vi

# Supported languages (comma-separated)
SUPPORTED_LANGS=vi,en,zh,ja,ko

# ===== API Keys (Optional - for future features) =====
# Social media embed API keys (if needed in future)
# PUBLIC_YOUTUBE_API_KEY=
# PUBLIC_FACEBOOK_APP_ID=

# ===== Development =====
# Development server port (default: 4321)
DEV_SERVER_PORT=4321

# Enable hot module replacement
ENABLE_HMR=true
