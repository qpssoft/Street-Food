---
/**
 * Food Detail Page (Dynamic Route)
 *
 * Displays detailed information for a single Vietnamese street food item.
 * Constitution Principle I: Content-First (comprehensive food information).
 * Constitution Principle III: WCAG 2.1 AA compliance (semantic HTML, accessibility).
 */

import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getFoodsByLanguage } from '@lib/content-queries';

export const getStaticPaths = (async () => {
  const allFoods = await getFoodsByLanguage('vi');

  return allFoods.map((food) => {
    // Extract just the filename from the slug (e.g., 'vi/banh-mi' -> 'banh-mi')
    const slug = food.slug.includes('/') ? food.slug.split('/').pop()! : food.slug;

    return {
      params: { slug },
      props: { food },
    };
  });
}) satisfies GetStaticPaths;

const { food } = Astro.props;
const { Content } = await food.render();

// Parse cooking method into steps
function parseCookingSteps(cookingMethod: string): string[] {
  // Split by numbered steps (e.g., "1.", "2.", etc.)
  const steps = cookingMethod
    .split(/\d+\.\s+/)
    .filter((step) => step.trim().length > 0)
    .map((step) => step.trim());
  return steps;
}

const cookingSteps = parseCookingSteps(food.data.cookingMethod);

// Category labels in Vietnamese
const categoryLabels: Record<string, string> = {
  grilled: 'Nướng',
  fresh: 'Tươi sống',
  fried: 'Chiên/Rán',
  noodle: 'Mì/Bún/Phở',
  rice: 'Cơm',
  dessert: 'Tráng miệng',
  beverage: 'Đồ uống',
};

// Consumption method labels
const consumptionMethodLabels: Record<string, string> = {
  takeaway: 'Mua mang về',
  'dine-in': 'Ăn tại chỗ',
  'street-side': 'Ăn vỉa hè',
  mixed: 'Linh hoạt',
};

// Eating time labels
const eatingTimeLabels: Record<string, string> = {
  morning: 'Sáng',
  afternoon: 'Trưa',
  evening: 'Chiều',
  night: 'Tối',
  anytime: 'Mọi lúc',
};
---

<BaseLayout
  title={`${food.data.name} - Ẩm thực đường phố Việt Nam`}
  description={food.data.description}
  lang="vi"
>
  <article class="food-detail">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">{food.data.name}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero Section with Image -->
    <section class="food-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-image-wrapper">
            <img
              src={food.data.image}
              alt={food.data.imageAlt}
              class="hero-image"
              loading="eager"
            />
            <span class="category-badge">
              {categoryLabels[food.data.category]}
            </span>
          </div>
          <div class="hero-text">
            <h1 class="food-title">{food.data.name}</h1>
            <p class="food-description">{food.data.description}</p>

            <!-- Metadata -->
            <dl class="food-metadata">
              <div class="metadata-item">
                <dt>Phân loại:</dt>
                <dd>{categoryLabels[food.data.category]}</dd>
              </div>
              <div class="metadata-item">
                <dt>Cách thưởng thức:</dt>
                <dd>{consumptionMethodLabels[food.data.consumptionMethod]}</dd>
              </div>
              <div class="metadata-item">
                <dt>Thời gian ăn:</dt>
                <dd>
                  {food.data.eatingTime.map((time) => eatingTimeLabels[time]).join(', ')}
                </dd>
              </div>
              <div class="metadata-item">
                <dt>Vùng miền:</dt>
                <dd>{food.data.province.join(', ')}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Image Gallery -->
    {
      food.data.images && food.data.images.length > 0 && (
        <section class="image-gallery">
          <div class="container">
            <h2 class="gallery-title">Hình ảnh chi tiết</h2>
            <div class="gallery-grid">
              {food.data.images.map((img) => (
                <div class="gallery-item">
                  <img src={img.url} alt={img.alt} class="gallery-image" loading="lazy" />
                  {img.caption && <p class="gallery-caption">{img.caption}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Detailed Content -->
    <section class="food-content">
      <div class="container">
        <div class="content-grid">
          <!-- Main Content (Markdown) -->
          <div class="main-content">
            <Content />
          </div>

          <!-- Sidebar with Additional Info -->
          <aside class="sidebar">
            <!-- Ingredients -->
            <div class="info-card ingredients-card">
              <h2 class="info-title">
                <span class="title-icon" aria-hidden="true">🥘</span>
                Nguyên liệu chính
              </h2>
              <ul class="ingredients-list">
                {food.data.ingredients.map((ingredient) => <li>{ingredient}</li>)}
              </ul>
            </div>

            <!-- Cooking Method -->
            <div class="info-card cooking-card">
              <h2 class="info-title">
                <span class="title-icon" aria-hidden="true">👨‍🍳</span>
                Phương pháp chế biến
              </h2>
              <ol class="cooking-steps">
                {
                  cookingSteps.map((step, index) => (
                    <li class="cooking-step">
                      <span class="step-number">{index + 1}</span>
                      <span class="step-text">{step}</span>
                    </li>
                  ))
                }
              </ol>
            </div>

            <!-- Cultural History (if available) -->
            {
              food.data.culturalHistory && (
                <div class="info-card history-card">
                  <h2 class="info-title">
                    <span class="title-icon" aria-hidden="true">📜</span>
                    Lịch sử văn hóa
                  </h2>
                  <div class="cultural-history">{food.data.culturalHistory}</div>
                </div>
              )
            }

            <!-- Consumption Guidance (if available) -->
            {
              food.data.consumptionGuidance && food.data.consumptionGuidance.length > 0 && (
                <div class="info-card guidance-card">
                  <h2 class="info-title">
                    <span class="title-icon" aria-hidden="true">🍽️</span>
                    Hướng dẫn thưởng thức
                  </h2>
                  <ol class="guidance-steps">
                    {food.data.consumptionGuidance.map((guide) => (
                      <li class="guidance-step">
                        <span class="guidance-number">{guide.step}</span>
                        <span class="guidance-text">{guide.instruction}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )
            }
          </aside>
        </div>

        <!-- Back to Home -->
        <div class="navigation-actions">
          <a href="/" class="back-button"> ← Quay lại trang chủ </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* ===== Breadcrumb ===== */
  .breadcrumb {
    background-color: var(--color-surface);
    padding: var(--spacing-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    list-style: none;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb-list li:not(:last-child)::after {
    content: '/';
    margin-left: var(--spacing-2);
    color: var(--color-text-muted);
  }

  .breadcrumb-list a {
    color: var(--color-primary-darker);
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    text-decoration: underline;
  }

  /* ===== Food Hero ===== */
  .food-hero {
    padding: var(--spacing-8) 0;
    background-color: var(--color-background);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .category-badge {
    position: absolute;
    top: var(--spacing-4);
    right: var(--spacing-4);
    background-color: rgba(255, 107, 53, 0.95);
    color: #ffffff;
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    box-shadow: var(--shadow-md);
  }

  .food-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: var(--spacing-3);
    line-height: var(--line-height-tight);
  }

  .food-description {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-6);
  }

  /* Tablet+: side-by-side layout */
  @media (min-width: 768px) {
    .hero-content {
      flex-direction: row;
      gap: var(--spacing-8);
    }

    .hero-image-wrapper {
      flex: 1 1 50%;
    }

    .hero-text {
      flex: 1 1 50%;
    }

    .food-title {
      font-size: var(--font-size-4xl);
    }
  }

  /* ===== Metadata ===== */
  .food-metadata {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
    padding: var(--spacing-5);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .metadata-item {
    display: flex;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
  }

  .metadata-item dt {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .metadata-item dd {
    color: var(--color-text-muted);
  }

  /* Tablet+: 2 columns */
  @media (min-width: 768px) {
    .food-metadata {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ===== Food Content ===== */
  .food-content {
    padding: var(--spacing-10) 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  .main-content {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  /* Desktop: sidebar layout */
  @media (min-width: 1024px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
      gap: var(--spacing-10);
    }
  }

  /* ===== Sidebar Info Cards ===== */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .info-card {
    padding: var(--spacing-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .info-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-dark);
  }

  /* Card variants */
  .ingredients-card {
    border-top: 3px solid #4ade80;
  }

  .cooking-card {
    border-top: 3px solid #fb923c;
  }

  .history-card {
    border-top: 3px solid #a78bfa;
  }

  .guidance-card {
    border-top: 3px solid var(--color-primary);
  }

  .info-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--spacing-4);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .title-icon {
    font-size: 1.5em;
    line-height: 1;
  }

  .ingredients-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2);
  }

  /* Tablet+: 2 columns for ingredients */
  @media (min-width: 768px) {
    .ingredients-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-3);
    }
  }

  /* Desktop: Back to 1 column in sidebar */
  @media (min-width: 1024px) {
    .ingredients-list {
      grid-template-columns: 1fr;
    }
  }

  .ingredients-list li {
    padding: var(--spacing-3) var(--spacing-4);
    padding-left: var(--spacing-10);
    position: relative;
    color: var(--color-text);
    background-color: var(--color-background);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary-darker);
    transition: all var(--transition-fast);
  }

  .ingredients-list li:hover {
    background-color: var(--color-surface-alt);
    transform: translateX(4px);
  }

  .ingredients-list li::before {
    content: '✓';
    position: absolute;
    left: var(--spacing-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-primary-darker);
    font-weight: var(--font-weight-bold);
    font-size: 1.2em;
  }

  /* Cooking Steps */
  .cooking-steps {
    list-style: none;
    padding: 0;
    counter-reset: step-counter;
  }

  .cooking-step {
    display: flex;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    margin-bottom: var(--spacing-3);
    background-color: var(--color-background);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
    position: relative;
  }

  .cooking-step:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .step-number {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-darker) 0%, var(--color-primary-dark) 100%);
    color: #ffffff;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  .step-text {
    flex: 1;
    color: var(--color-text);
    line-height: var(--line-height-relaxed);
    padding-top: var(--spacing-1);
  }

  .cultural-history {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    white-space: pre-line;
  }

  /* Consumption Guidance */
  .guidance-steps {
    list-style: none;
    padding: 0;
  }

  .guidance-step {
    display: flex;
    gap: var(--spacing-3);
    padding: var(--spacing-3);
    margin-bottom: var(--spacing-3);
    background: linear-gradient(
      135deg,
      rgba(255, 107, 53, 0.05) 0%,
      rgba(255, 107, 53, 0.02) 100%
    );
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
    transition: all var(--transition-fast);
  }

  .guidance-step:hover {
    background: linear-gradient(
      135deg,
      rgba(255, 107, 53, 0.1) 0%,
      rgba(255, 107, 53, 0.05) 100%
    );
    transform: translateX(4px);
  }

  .guidance-number {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: #ffffff;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    border-radius: 50%;
  }

  .guidance-text {
    flex: 1;
    color: var(--color-text);
    line-height: var(--line-height-relaxed);
    font-size: var(--font-size-sm);
  }

  /* ===== Navigation Actions ===== */
  .navigation-actions {
    margin-top: var(--spacing-10);
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--spacing-3) var(--spacing-6);
    background-color: var(--color-primary-darker);
    color: #ffffff;
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-md);
  }

  .back-button:hover {
    background-color: var(--color-primary-dark);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .back-button:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  .back-button:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Tablet+ adjustments */
  @media (min-width: 768px) {
    .back-button {
      min-width: 48px;
      min-height: 48px;
    }
  }

  /* ===== Image Gallery ===== */
  .image-gallery {
    padding: var(--spacing-10) 0;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .gallery-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: var(--spacing-6);
    text-align: center;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-8);
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    background-color: var(--color-background);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .gallery-item:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .gallery-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .gallery-caption {
    padding: var(--spacing-3) var(--spacing-4);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-align: center;
    line-height: var(--line-height-normal);
    background-color: var(--color-background);
  }
</style>
