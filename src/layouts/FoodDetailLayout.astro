---
/**
 * FoodDetailLayout Component
 *
 * Specialized layout for food detail pages extending BaseLayout.
 * Adds enhanced SEO meta tags, structured data (JSON-LD), and Open Graph optimization.
 *
 * Constitution Principle III: Accessibility with semantic HTML.
 * Constitution Principle IV: Performance with optimized meta tags.
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  // Food item data
  name: string;
  description: string;
  slug: string;
  lang?: 'vi' | 'en' | 'zh' | 'ja' | 'ko';

  // Content metadata
  image?: string;
  imageAlt?: string;
  category?: string;
  province?: string[];
  eatingTime?: string[];
  ingredients?: string[];

  // SEO overrides
  customTitle?: string;
  customDescription?: string;
}

const {
  name,
  description,
  slug,
  lang = 'vi',
  image,
  imageAlt,
  category,
  province = [],
  eatingTime = [],
  ingredients = [],
  customTitle,
  customDescription,
} = Astro.props;

// SEO-optimized title and description
const pageTitle = customTitle || name;
const pageDescription =
  customDescription || description.length > 160 ? description.substring(0, 157) + '...' : description;

// Construct full image URL for Open Graph
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

// Generate canonical URL
const canonicalURL = new URL(`/${lang}/${slug}`, Astro.site).toString();

// Structured Data (JSON-LD) for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: name,
  description: description,
  image: ogImage,
  recipeCategory: category,
  recipeIngredient: ingredients,
  recipeYield: '1 serving',
  recipeCuisine: 'Vietnamese',
  keywords: [
    'Vietnamese food',
    'Street food',
    name,
    category,
    ...province,
    ...eatingTime,
  ]
    .filter(Boolean)
    .join(', '),
  inLanguage: lang,
  url: canonicalURL,
};

// Alternate language versions (hreflang)
const languages = ['vi', 'en', 'zh', 'ja', 'ko'];
const alternateUrls = languages.map((l) => ({
  lang: l,
  url: new URL(`/${l}/${slug}`, Astro.site).toString(),
}));
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang} ogImage={image}>
  <!-- Enhanced Meta Tags -->
  <Fragment slot="head">
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang for multi-language support (Phase 5) -->
    {
      alternateUrls.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={alt.url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(`/vi/${slug}`, Astro.site).toString()} />

    <!-- Enhanced Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : `${lang}_${lang.toUpperCase()}`} />
    {
      alternateUrls
        .filter((alt) => alt.lang !== lang)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={alt.lang === 'vi' ? 'vi_VN' : `${alt.lang}_${alt.lang.toUpperCase()}`}
          />
        ))
    }

    <!-- Enhanced Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- Article-specific Meta -->
    <meta name="article:author" content="Vietnamese Street Food Team" />
    <meta name="article:published_time" content={new Date().toISOString()} />
    {category && <meta name="article:tag" content={category} />}
    {province.map((p) => <meta name="article:tag" content={p} />)}

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Breadcrumb Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: lang === 'vi' ? 'Trang chủ' : 'Home',
            item: new URL('/', Astro.site).toString(),
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: name,
            item: canonicalURL,
          },
        ],
      })}
    />
  </Fragment>

  <!-- Page Content -->
  <article class="food-detail" itemscope itemtype="https://schema.org/Recipe">
    <!-- Hidden microdata for enhanced SEO -->
    <meta itemprop="name" content={name} />
    <meta itemprop="description" content={description} />
    {ogImage && <meta itemprop="image" content={ogImage} />}
    {category && <meta itemprop="recipeCategory" content={category} />}
    <meta itemprop="recipeCuisine" content="Vietnamese" />
    {ingredients.map((ingredient) => <meta itemprop="recipeIngredient" content={ingredient} />)}

    <!-- Main Content Slot -->
    <slot />
  </article>
</BaseLayout>

<style>
  .food-detail {
    /* Container for food detail content */
    width: 100%;
  }

  /* Mobile-first typography enhancements */
  .food-detail :global(h1) {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    margin-bottom: var(--spacing-4);
    color: var(--color-text);
  }

  .food-detail :global(h2) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    margin-top: var(--spacing-8);
    margin-bottom: var(--spacing-4);
    color: var(--color-text);
  }

  .food-detail :global(p) {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-4);
    color: var(--color-text);
  }

  .food-detail :global(ul),
  .food-detail :global(ol) {
    margin-bottom: var(--spacing-4);
    padding-left: var(--spacing-6);
  }

  .food-detail :global(li) {
    margin-bottom: var(--spacing-2);
    line-height: var(--line-height-relaxed);
  }

  /* Tablet and Desktop (min-width: 768px) */
  @media (min-width: 768px) {
    .food-detail :global(h1) {
      font-size: var(--font-size-3xl);
    }

    .food-detail :global(h2) {
      font-size: var(--font-size-2xl);
    }

    .food-detail :global(p) {
      font-size: var(--font-size-lg);
    }
  }
</style>
